// Procedural streaming world: a scatter field of varied spheres you fly through
// with WASD. Chunks stream in/out around the camera. (Phase 2/3 brute-force
// density is kept modest; the uniform-grid accelerator scales this up.)
World((
    title: "Scatter World",
    description: "An endless field of scattered procedural spheres.",
    music: "dorian",
    camera_mode: Drift,
    world_seed: 12648430,
    chunk_size: 8.0,
    view_radius: 2,
    max_spheres: 220,
    palette: {
        "red":    Lambertian((0.85, 0.35, 0.30)),
        "blue":   Lambertian((0.30, 0.55, 0.85)),
        "gold":   Lambertian((0.90, 0.80, 0.30)),
        "metal":  Metal((0.85, 0.85, 0.90)),
        "green":  Lambertian((0.45, 0.75, 0.45)),
        "ground": Lambertian((0.55, 0.55, 0.58)),
    },
    ground: "ground",
    biome: Scatter(
        density: 4,
        min_r: 0.3,
        max_r: 0.9,
        y_jitter: 0.4,
        mats: ["red", "blue", "gold", "metal", "green"],
    ),
    camera: LookAt(
        eye: (0.0, 2.5, 0.0),
        center: (0.0, 1.8, -6.0),
        up: (0.0, 1.0, 0.0),
        fov: 55.0,
    ),
))
