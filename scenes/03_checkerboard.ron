// A 6x6 checkerboard of spheres alternating glass and blue, on the ground.
// Demonstrates the `Grid` generator with `checker: true` and an `Orbit` camera.
(
    materials: {
        "glass":  Dielectric(ior: 1.5),
        "blue":   Opaque((0.0, 0.2, 0.9), 0.001),
        "ground": Lambertian((0.7, 0.9, 0.2)),
    },
    objects: [
        Grid(
            origin: (0.0, 0.0, 0.0),
            cols: 6,
            rows: 6,
            spacing: 1.0,
            y: 0.5,
            r: 0.4,
            materials: ["glass", "blue"],
            checker: true,
        ),
        Ground("ground"),
    ],
    camera: LookAt(
        eye: (6.0, 5.0, 6.0),
        center: (0.0, 0.5, 0.0),
        up: (0.0, 1.0, 0.0),
        fov: 35.0,
    ),
    path: Orbit(center: (0.0, 0.5, 0.0), radius: 7.0, height: 4.0, fov: 35.0, secs: 4.0, steps: 6),
)
