// A glossy dark room with low cyan/magenta wall lights and glass spheres across
// a reflective "pool" floor. It is intentionally simpler than the outdoor neon
// scene, so the reflections converge while the camera moves.
(
    materials: {
        "floor":    Opaque((0.015, 0.025, 0.034), 0.42),
        "wall":     Lambertian((0.045, 0.050, 0.070)),
        "ceiling":  Lambertian((0.030, 0.032, 0.045)),
        "cyan":     Emissive((0.20, 0.95, 1.0), 7.0),
        "magenta":  Emissive((1.0, 0.18, 0.78), 6.0),
        "blue":     Emissive((0.18, 0.34, 1.0), 5.0),
        "glass":    Dielectric(ior: 1.5, color: (0.72, 0.92, 1.0)),
        "chrome":   Metal((0.86, 0.90, 0.96)),
        "void":     Lambertian((0.0, 0.0, 0.0)),
    },
    objects: [
        Room(
            min: (-3.4, 0.0, -3.8),
            max: ( 3.4, 3.6,  2.2),
            floor:   "floor",
            ceiling: "ceiling",
            back:    "wall",
            left:    "wall",
            right:   "wall",
        ),

        Sphere(at: (-2.65, 1.15, -2.8), r: 0.24, mat: "cyan"),
        Sphere(at: (-2.65, 1.15, -1.2), r: 0.24, mat: "blue"),
        Sphere(at: (-2.65, 1.15,  0.4), r: 0.24, mat: "magenta"),
        Sphere(at: ( 2.65, 1.15, -2.8), r: 0.24, mat: "magenta"),
        Sphere(at: ( 2.65, 1.15, -1.2), r: 0.24, mat: "cyan"),
        Sphere(at: ( 2.65, 1.15,  0.4), r: 0.24, mat: "blue"),

        Sphere(at: (-1.45, 0.38, -1.65), r: 0.38, mat: "glass"),
        Sphere(at: ( 0.10, 0.52, -1.20), r: 0.52, mat: "chrome"),
        Sphere(at: ( 1.35, 0.36, -0.55), r: 0.36, mat: "glass"),
        Sphere(at: (-0.25, 0.28,  0.45), r: 0.28, mat: "glass"),

        Sphere(at: (0.0, 1.7, -0.8), r: 5000.0, mat: "void"),
    ],
    camera: LookAt(
        eye: (0.0, 1.35, 7.0),
        center: (0.0, 0.9, -1.0),
        up: (0.0, 1.0, 0.0),
        fov: 39.0,
    ),
    path: Keyframes(
        secs_per_segment: 5.5,
        looping: true,
        frames: [
            (eye: (-2.3, 1.65, 7.2), center: (-0.2, 0.8, -1.6), fov: 39.0),
            (eye: ( 0.0, 1.10, 5.5), center: ( 0.1, 0.6, -1.5), fov: 43.0),
            (eye: ( 2.3, 1.65, 7.2), center: ( 0.2, 0.8, -1.6), fov: 39.0),
            (eye: (-2.3, 1.65, 7.2), center: (-0.2, 0.8, -1.6), fov: 39.0),
        ],
    ),
)
