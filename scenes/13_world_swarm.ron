// Procedural streaming world: a swarm of emissive orbs drifting in the dark in
// varied colors — a drifting nebula. Fly up into the cloud. The dark background
// (sky: 0.0) makes the glowing orbs pop; no ground.
World((
    world_seed: 31337,
    chunk_size: 8.0,
    view_radius: 3,
    max_spheres: 350,
    sky: 0.0,
    background: (0.01, 0.01, 0.03),
    palette: {
        "cyan":    Emissive((0.3, 0.9, 1.0), 5.0),
        "magenta": Emissive((1.0, 0.3, 0.9), 5.0),
        "amber":   Emissive((1.0, 0.7, 0.2), 5.0),
        "lime":    Emissive((0.5, 1.0, 0.3), 5.0),
    },
    biome: Swarm(
        count: 5,
        y_lo: 3.0,
        y_hi: 12.0,
        r: 0.4,
        mats: ["cyan", "magenta", "amber", "lime"],
    ),
    camera: LookAt(
        eye: (0.0, 4.0, 0.0),
        center: (0.0, 6.0, -8.0),
        up: (0.0, 1.0, 0.0),
        fov: 60.0,
    ),
))
