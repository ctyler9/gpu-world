// Procedural streaming world: a rolling landscape whose sphere heights follow
// world-space fbm noise (seamless across chunk borders). Skim over the hills.
World((
    title: "Terrain World",
    description: "A streaming procedural terrain built from sphere bands.",
    music: "mixolydian",
    camera_mode: Drift,
    world_seed: 777,
    chunk_size: 8.0,
    view_radius: 3,
    max_spheres: 400,
    palette: {
        "low":  Lambertian((0.25, 0.45, 0.65)), // valleys
        "mid":  Lambertian((0.45, 0.70, 0.40)), // slopes
        "high": Lambertian((0.85, 0.85, 0.88)), // peaks
    },
    ground: "low",
    biome: Terrain(
        cell: 4.0,
        feature_size: 30.0,
        height_scale: 5.0,
        base_r: 1.4,
        octaves: 4,
        bands: ["low", "mid", "high"],
    ),
    camera: LookAt(
        eye: (0.0, 6.0, 6.0),
        center: (0.0, 2.0, -8.0),
        up: (0.0, 1.0, 0.0),
        fov: 55.0,
    ),
))
