// A long interior corridor with repeated emissive "portal" beads down the side
// walls. The camera path slowly pushes forward, making this one good with P
// playback or auto-drift.
(
    title: "Portal Corridor",
    description: "A long corridor with repeated emissive portal beads along the walls.",
    music: "lydian",
    camera_mode: Path,
    materials: {
        "floor":    Opaque((0.035, 0.036, 0.040), 0.25),
        "wall":     Lambertian((0.09, 0.095, 0.105)),
        "ceiling":  Lambertian((0.06, 0.065, 0.075)),
        "cyan":     Emissive((0.20, 0.92, 1.0), 5.8),
        "amber":    Emissive((1.0, 0.56, 0.18), 5.3),
        "violet":   Emissive((0.72, 0.30, 1.0), 5.0),
        "chrome":   Metal((0.82, 0.86, 0.92)),
        "glass":    Dielectric(ior: 1.48, color: (0.80, 0.90, 1.0)),
        "void":     Lambertian((0.0, 0.0, 0.0)),
    },
    objects: [
        Room(
            min: (-2.0, 0.0, -8.2),
            max: ( 2.0, 3.4,  1.8),
            floor:   "floor",
            ceiling: "ceiling",
            back:    "wall",
            left:    "wall",
            right:   "wall",
        ),

        Sphere(at: (-1.55, 1.15,  0.7), r: 0.18, mat: "cyan"),
        Sphere(at: ( 1.55, 1.15,  0.7), r: 0.18, mat: "amber"),
        Sphere(at: (-1.55, 2.10,  0.7), r: 0.18, mat: "violet"),
        Sphere(at: ( 1.55, 2.10,  0.7), r: 0.18, mat: "cyan"),

        Sphere(at: (-1.55, 1.15, -1.4), r: 0.18, mat: "amber"),
        Sphere(at: ( 1.55, 1.15, -1.4), r: 0.18, mat: "violet"),
        Sphere(at: (-1.55, 2.10, -1.4), r: 0.18, mat: "cyan"),
        Sphere(at: ( 1.55, 2.10, -1.4), r: 0.18, mat: "amber"),

        Sphere(at: (-1.55, 1.15, -3.5), r: 0.18, mat: "violet"),
        Sphere(at: ( 1.55, 1.15, -3.5), r: 0.18, mat: "cyan"),
        Sphere(at: (-1.55, 2.10, -3.5), r: 0.18, mat: "amber"),
        Sphere(at: ( 1.55, 2.10, -3.5), r: 0.18, mat: "violet"),

        Sphere(at: (-1.55, 1.15, -5.6), r: 0.18, mat: "cyan"),
        Sphere(at: ( 1.55, 1.15, -5.6), r: 0.18, mat: "amber"),
        Sphere(at: (-1.55, 2.10, -5.6), r: 0.18, mat: "violet"),
        Sphere(at: ( 1.55, 2.10, -5.6), r: 0.18, mat: "cyan"),

        Arch(center: (0.0, 0.0, -0.2), width: 3.2, height: 2.65, depth: 0.22, thickness: 0.28, mat: "chrome"),
        Arch(center: (0.0, 0.0, -2.9), width: 3.2, height: 2.65, depth: 0.22, thickness: 0.28, mat: "chrome"),
        Arch(center: (0.0, 0.0, -5.6), width: 3.2, height: 2.65, depth: 0.22, thickness: 0.28, mat: "chrome"),

        Sphere(at: (0.0, 0.55, -1.8), r: 0.55, mat: "chrome"),
        Sphere(at: (0.0, 0.38, -4.5), r: 0.38, mat: "glass"),
        Sphere(at: (0.0, 1.7, -3.2), r: 5000.0, mat: "void"),
    ],
    camera: LookAt(
        eye: (0.0, 1.55, 5.8),
        center: (0.0, 1.35, -2.8),
        up: (0.0, 1.0, 0.0),
        fov: 42.0,
    ),
    path: Keyframes(
        secs_per_segment: 4.5,
        looping: true,
        frames: [
            (eye: ( 0.0, 1.55, 5.8), center: ( 0.0, 1.35, -2.8), fov: 42.0),
            (eye: (-0.7, 1.25, 2.2), center: (-0.2, 1.20, -4.2), fov: 45.0),
            (eye: ( 0.7, 1.70, 0.0), center: ( 0.2, 1.45, -6.0), fov: 43.0),
            (eye: ( 0.0, 1.55, 5.8), center: ( 0.0, 1.35, -2.8), fov: 42.0),
        ],
    ),
)
