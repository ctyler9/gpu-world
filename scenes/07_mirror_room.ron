// A hall of mirrors. The back and side walls are metal, so the lamp and the
// colored spheres reflect over and over (up to the path tracer's bounce limit).
// White floor/ceiling, open front, black void behind it.
(
    title: "Mirror Room",
    description: "Reflective walls multiply lamps and objects through the room.",
    music: "aeolian",
    camera_mode: Path,
    materials: {
        "floor":  Lambertian((0.20, 0.20, 0.24)),
        "white":  Lambertian((0.78, 0.78, 0.78)),
        "mirror": Metal((0.95, 0.95, 0.97)),
        "lamp":   Emissive((1.0, 0.95, 0.85), 16.0),
        "ruby":   Opaque((0.9, 0.1, 0.2), 0.05),
        "gold":   Metal((1.0, 0.78, 0.34)),
        "glass":  Dielectric(ior: 1.5),
        "void":   Lambertian((0.0, 0.0, 0.0)),
    },
    objects: [
        Room(
            min: (-2.5, 0.0, -2.5),
            max: ( 2.5, 4.0,  2.5),
            floor:   "floor",
            ceiling: "white",
            back:    "mirror",
            left:    "mirror",
            right:   "mirror",
        ),

        // Ceiling lamp.
        Sphere(at: (0.0, 3.5, -0.5), r: 0.4, mat: "lamp"),

        // A little arrangement to be reflected to infinity.
        Sphere(at: (-0.9, 0.6, 0.2), r: 0.6, mat: "ruby"),
        Sphere(at: ( 0.8, 0.7, -0.3), r: 0.7, mat: "gold"),
        Sphere(at: ( 0.1, 0.45, 1.0), r: 0.45, mat: "glass"),

        Sphere(at: (0.0, 2.0, 0.0), r: 5000.0, mat: "void"),
    ],
    camera: LookAt(
        eye: (0.0, 2.2, 8.5),
        center: (0.0, 1.4, 0.0),
        up: (0.0, 1.0, 0.0),
        fov: 35.0,
    ),
    // Slow push toward the opening, drifting side to side.
    path: Keyframes(
        secs_per_segment: 6.0,
        looping: true,
        frames: [
            (eye: (-2.0, 2.4, 9.0), center: (0.0, 1.4, 0.0), fov: 35.0),
            (eye: ( 0.0, 1.8, 6.0), center: (0.0, 1.3, 0.0), fov: 40.0),
            (eye: ( 2.0, 2.4, 9.0), center: (0.0, 1.4, 0.0), fov: 35.0),
            (eye: (-2.0, 2.4, 9.0), center: (0.0, 1.4, 0.0), fov: 35.0),
        ],
    ),
)
